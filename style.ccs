/* ===========================
   RESET
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:linear-gradient(#6fc8ff,#bde9ff);
    overflow-x:hidden;
    color:#222;
}

/* ===========================
   HERO
=========================== */

.hero{
    position:relative;
    height:100vh;

    display:flex;
    justify-content:center;
    align-items:center;

    text-align:center;

    overflow:hidden;

    background:
    linear-gradient(#62c6ff,#bfe9ff);
}

.hero-content{
    z-index:5;
}

.hero h1{

    font-family:'Press Start 2P',cursive;

    color:#fff;

    font-size:2rem;

    text-shadow:
    5px 5px 0 #d62828,
    8px 8px 0 #000;
}

.hero p{

    margin-top:30px;

    color:white;

    font-size:18px;
}

.btn{

display:inline-block;

margin-top:40px;

padding:18px 35px;

background:#ff3b30;

color:white;

text-decoration:none;

font-weight:bold;

border-radius:15px;

transition:.3s;

box-shadow:0 8px 0 #b81d14;

}

.btn:hover{

transform:translateY(-6px);

box-shadow:0 14px 0 #b81d14;

}

/* ===========================
   CLOUD
=========================== */

.cloud{

position:absolute;

width:220px;

height:70px;

background:white;

border-radius:100px;

}

.cloud::before{

content:"";

position:absolute;

width:90px;

height:90px;

background:white;

left:20px;

top:-40px;

border-radius:50%;

}

.cloud::after{

content:"";

position:absolute;

width:100px;

height:100px;

background:white;

right:30px;

top:-45px;

border-radius:50%;

}

.cloud1{

top:90px;

left:-250px;

animation:cloudMove 40s linear infinite;

}

.cloud2{

top:240px;

animation:cloudMove 55s linear infinite;

animation-delay:8s;

}

.cloud3{

top:160px;

animation:cloudMove 48s linear infinite;

animation-delay:15s;

}

@keyframes cloudMove{

0%{

transform:translateX(-300px);

}

100%{

transform:translateX(1800px);

}

}

/* ===========================
SECTION
=========================== */

.section{

padding:90px 8%;

}

.section h2{

text-align:center;

font-size:34px;

margin-bottom:50px;

color:#d62828;

}

/* ===========================
WALI
=========================== */

.leader-card{

width:320px;

margin:auto;

padding:30px;

background:white;

border-radius:25px;

text-align:center;

box-shadow:0 15px 40px rgba(0,0,0,.2);

transition:.4s;

border:6px solid #ffcc00;

}

.leader-card:hover{

transform:translateY(-12px);

}

.leader-card img{

width:170px;

height:170px;

border-radius:50%;

border:7px solid red;

object-fit:cover;

}

.leader-card h3{

margin-top:20px;

font-size:28px;

}

.leader-card p{

margin-top:10px;

font-size:18px;

color:#777;

}

/* ===========================
GRID SISWA
=========================== */

.students{

display:grid;

grid-template-columns:

repeat(auto-fit,minmax(220px,1fr));

gap:35px;

}

.student-card{

background:white;

padding:25px;

border-radius:20px;

text-align:center;

transition:.4s;

cursor:pointer;

box-shadow:0 10px 25px rgba(0,0,0,.15);

border:4px solid transparent;

}

.student-card:hover{

transform:
translateY(-12px)
scale(1.05);

border-color:#ffcc00;

}

.student-card img{

width:120px;

height:120px;

border-radius:50%;

object-fit:cover;

border:5px solid #ff3b30;

}

.student-card h3{

margin-top:18px;

font-size:22px;

}

.student-card p{

margin-top:8px;

color:#666;

}

/* ===========================
FOOTER
=========================== */

footer{

margin-top:70px;

padding:30px;

background:#d62828;

color:white;

font-weight:bold;

text-align:center;

}

/* ===========================
ANIMASI DASAR
=========================== */

.reveal{

opacity:0;

transition:1s;

}

.reveal.active{

opacity:1;

transform:none;

}

.left{

transform:translateX(-120px);

}

.right{

transform:translateX(120px);

}

.up{

transform:translateY(120px);

}

.zoom{

transform:scale(.4);

}

.rotate{

transform:rotate(-180deg);

}

.flip{

transform:rotateY(180deg);

}

.bounce{

transform:translateY(120px);

}

/* ===========================
RESPONSIVE
=========================== */

@media(max-width:768px){

.hero h1{

font-size:1.2rem;

line-height:1.7;

}

.section h2{

font-size:26px;

}

.leader-card{

width:100%;

}

      }
